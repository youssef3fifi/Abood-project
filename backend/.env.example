# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/travel-system
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/travel-system

# JWT Secret (change this to a random secure string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS Configuration (for AWS EC2 deployment)
# Set to your frontend URL or '*' for development
# Examples:
# FRONTEND_URL=http://localhost:8080
# FRONTEND_URL=http://your-ec2-public-ip
# FRONTEND_URL=http://54.123.45.67
FRONTEND_URL=*

# AWS EC2 Configuration
# The server will bind to 0.0.0.0 to accept external connections
# Make sure your EC2 security group allows inbound traffic on the PORT above
